    {
      "id": 8,
      "type": "logs",
      "title": "Codex Logs - readable event stream with trace ids",
      "description": "Large panel on purpose. Expand any log row to see labels; copy trace_id into Tempo when present.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"$service\"} | line_format \"{{.event_name}} {{.rpc_method}} {{.event_kind}} model={{.model}} in={{.input_token_count}} out={{.output_token_count}} duration={{.duration_ms}}ms trace={{.trace_id}}\"",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
