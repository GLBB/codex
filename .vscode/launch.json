        },
        "problemMatcher": "$rustc"
      },
      "args": [
        "-c",
        "log_dir=\"${workspaceFolder}/.codex-debug-logs\"",
        "--no-alt-screen"
      ],
      "env": {
        "CODEX_TUI_RECORD_SESSION": "1",
