{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch",
      "cargo": {
        "args": ["build", "--bin", "codex-tui"],
        "cwd": "${workspaceFolder}/codex-rs",
        "env": {
          "CARGO_PROFILE_DEV_DEBUG": "limited",
          "CARGO_PROFILE_DEV_OPT_LEVEL": "0",
          "CARGO_PROFILE_DEV_STRIP": "false",
          "CARGO_BUILD_JOBS": "2",
          "CARGO_TARGET_DIR": "${workspaceFolder}/codex-rs/target/vscode-debug-fast",
          "RUSTFLAGS": "-C dwarf-version=4"
        },
        "problemMatcher": "$rustc"
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Cargo launch (observability)",
